{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.umd.io/v1/schemas/professor.json",
  "title": "Professor",
  "description": "Represents a University of Maryland professor and the courses they have taught, in the umd.io API.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Professor's name on Testudo.",
      "examples": ["Aaron Bartlett"]
    },
    "taught": {
      "type": "array",
      "description": "An array of courses taught, along with the semester they were taught.",
      "items": {
        "type": "object",
        "properties": {
          "semester": { "type": "integer", "description": "Numeric semester in format YYYYMM.", "examples": [202001] },
          "course": { "type": "string", "description": "Course id taught.", "examples": ["ENGL101"] }
        }
      }
    }
  }
}
