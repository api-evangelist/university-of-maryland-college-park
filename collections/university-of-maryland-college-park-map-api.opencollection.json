          "http": {
            "method": "GET",
            "url": "https://api.umd.io/v1/map/buildings/:building_id",
            "params": [
              {
                "name": "building_id",
                "value": "",
                "type": "path",
                "description": "Numeric building ID"
              }
            ]
          },
          "docs": "Get location data about one or more buildings. Comma separated building numbers are the parameters."
        }
      ]
    }
  ],
